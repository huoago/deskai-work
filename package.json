{
  "name": "deskai-work",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run tauri:dev",
    "build:web": "npm --workspace apps/desktop run build",
